# ─── LOCAL DEVELOPMENT ─────────────────────────────────────────────────────────
# Leave empty during local dev — vite.config.js proxy handles /api → localhost:8000
VITE_API_URL=

# ─── PRODUCTION (fill this AFTER deploying backend to Render) ──────────────────
# Example: VITE_API_URL=https://swaraj-saathi-backend.onrender.com
# Set this in Vercel → Project → Settings → Environment Variables
